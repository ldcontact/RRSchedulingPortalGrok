# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Invite emails, suspend bans, admin set-password. NEVER prefix with NEXT_PUBLIC_.
# On Vercel: Production env, mark Sensitive / encrypted.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app (used in email links). e.g. https://rr-scheduler.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- DEV ONLY: run without Supabase using local sample data + demo-user login ---
# NEXT_PUBLIC_RR_MOCK_MODE=1

# --- Geotab (server-only — never prefix with NEXT_PUBLIC_). Service Account, View only, no MFA/SAML. ---
# On Vercel: Production env, mark Sensitive / encrypted.
GEOTAB_DATABASE=
GEOTAB_USERNAME=
GEOTAB_PASSWORD=
# Optional. Default my.geotab.com; the client follows LoginResult.path if the account is on another host.
# GEOTAB_SERVER=my.geotab.com

# --- Outbound email (server-only — never prefix with NEXT_PUBLIC_) ---
# Preferred: Google Workspace service account with domain-wide delegation
# (scope https://www.googleapis.com/auth/gmail.send), impersonating EMAIL_SENDER.
# Paste the JSON key (or its base64) and mark the var Sensitive on Vercel.
# GOOGLE_MAILER_SA_JSON={"type":"service_account",...}
# GOOGLE_MAILER_SA_JSON_B64=
EMAIL_SENDER=admin@retrofitrebates.com
# Display name, bare mailbox, or full "Name <email>" value. Default name: Retrofit Rebates Scheduler.
EMAIL_FROM=Retrofit Rebates Scheduler

# Fallback if the service account JSON is not set: Gmail SMTP app password
# (2-Step Verification required). On Vercel: mark SMTP_PASSWORD Sensitive.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=admin@retrofitrebates.com
SMTP_PASSWORD=

# --- Sales CRM SMS (Twilio; server-only — never prefix with NEXT_PUBLIC_) ---
# Leave these unset until A2P 10DLC brand + campaign registration is approved.
# Then create a NEW dedicated Messaging Service for Sales (do not reuse
# "Unify Notification") and set:
# SALES_SMS_PROVIDER=twilio
# SALES_SMS_ALLOW_SEND=1
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# Outgoing texts stay drafts until a rep clicks Send. Nothing auto-sends.
